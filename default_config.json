{
  "configVersion": 1,
  "minExtensionVersion": "1.6.0",
  "killSwitch": false,
  "ttlSeconds": 21600,
  "debounceMs": 2200,
  "platforms": {
    "chatgpt": {
      "enabled": true,
      "killSwitch": false,
      "latestAssistantSelector": "[data-message-author-role=\"assistant\"]",
      "assistantTextSelector": ".markdown, [class*=\"markdown\"]",
      "generatingSelector": "button[aria-label*=\"Stop\"], button:has(svg[aria-label*=\"Stop\"])"
    },
    "claude": {
      "enabled": true,
      "killSwitch": false,
      "latestAssistantSelector": "[data-testid*=\"message\"]",
      "assistantTextSelector": null,
      "generatingSelector": "button:has(svg[aria-label*=\"Stop\"]), [data-is-streaming=\"true\"]"
    },
    "gemini": {
      "enabled": true,
      "killSwitch": false,
      "latestAssistantSelector": "[id^=\"model-response-message-content\"], message-content, [id^=\"message-content-id\"]",
      "assistantTextSelector": null,
      "generatingSelector": "button[aria-label*=\"Stop\"], [data-test-id*=\"stop\"], [data-testid*=\"stop\"]"
    },
    "grok": {
      "enabled": true,
      "killSwitch": false,
      "latestAssistantSelector": "[data-testid*=\"assistant\"], [class*=\"message-bubble\"], [class*=\"response-message\"]",
      "assistantTextSelector": "[class*=\"markdown\"], [class*=\"message-text\"]",
      "generatingSelector": "button[aria-label*=\"Stop\"], [class*=\"stop\"], [data-testid*=\"stop\"]"
    },
    "deepseek": {
      "enabled": true,
      "killSwitch": false,
      "latestAssistantSelector": ".ds-markdown, [data-role=\"assistant\"], [class*=\"assistant-message\"]",
      "assistantTextSelector": ".ds-markdown, [class*=\"markdown-body\"], [class*=\"markdown\"]",
      "generatingSelector": "button[aria-label*=\"Stop\"], [class*=\"stop-generating\"], [class*=\"loading\"]"
    }
  }
}